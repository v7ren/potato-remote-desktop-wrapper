+void Session::solinearToolbarRefresh()
+{
+    if (m_ToolbarScreens < 0 || !m_ToolbarShown) {
+        m_OverlayManager.setToolbar({}, {});
+        return;
+    }
+    QStringList labels;
+    QVector<bool> lit;
+    for (int i = 1; m_ToolbarScreens > 1 && i <= m_ToolbarScreens; i++) {
+        labels << QString::number(i);
+        lit << (i == m_ToolbarScreen);
+    }
+    labels << "FULL" << "GAME" << "MORE" << "END";
+    lit << false << m_InputHandler->isRelativeMouseMode() << false << false;
+    m_OverlayManager.setToolbar(labels, lit);
+}
+
+void Session::solinearToolbarAction(int button)
+{
+    const int screens = m_ToolbarScreens > 1 ? m_ToolbarScreens : 0;
+    if (button < screens) {
+        m_ToolbarScreen = button + 1;
+        m_InputHandler->sendHostShortcut(0x70 + button);  // VK_F1 + n
+        solinearStatus(QString("toolbar screen %1").arg(button + 1));
+    }
+    else {
+        switch (button - screens) {
+        case 0:
+            m_InputHandler->performNamedCombo("fullscreen");
+            solinearStatus("toolbar fullscreen");
+            break;
+        case 1:
+            m_InputHandler->performNamedCombo("mouse-mode");
+            solinearStatus(m_InputHandler->isRelativeMouseMode() ? "toolbar game on" : "toolbar game off");
+            break;
+        case 2:
+            solinearStatus("toolbar more");  // the launcher shows its full menu
+            break;
+        case 3:
+            m_InputHandler->performNamedCombo("quit");
+            break;
+        }
+    }
+    m_ToolbarHideAt = SDL_GetTicks() + 2500;
+    solinearToolbarRefresh();
+}
+
+bool Session::solinearToolbarMouse(const SDL_Event* event)
+{
+    if (m_ToolbarScreens < 0 || m_Window == nullptr) {
+        return false;
+    }
+    int ww, wh, pw, ph;
+    SDL_GetWindowSize(m_Window, &ww, &wh);
+    SDL_GetWindowSizeInPixels(m_Window, &pw, &ph);
+    if (ww <= 0 || wh <= 0) {
+        return false;
+    }
+    const QSize bar = m_OverlayManager.toolbarSize();
+    const int barX = (pw - bar.width()) / 2;
+    auto toPixels = [&](int x, int y) { return QPoint(x * pw / ww, y * ph / wh); };
+
+    switch (event->type) {
+    case SDL_MOUSEMOTION:
+        {
+            if (SDL_GetRelativeMouseMode()) {
+                return false;  // gaming mode: no pointer to hover with (Ctrl+Alt+Shift+Z frees it)
+            }
+            QPoint p = toPixels(event->motion.x, event->motion.y);
+            bool overBar = m_ToolbarShown && p.y() < bar.height() && p.x() >= barX && p.x() < barX + bar.width();
+            if (p.y() < SDL_max(ph / 40, 6) || overBar) {
+                m_ToolbarHideAt = SDL_GetTicks() + 2500;
+                if (!m_ToolbarShown) {
+                    m_ToolbarShown = true;
+                    solinearToolbarRefresh();
+                }
+            }
+            return false;  // movement still reaches the host
+        }
+    case SDL_MOUSEBUTTONDOWN:
+        {
+            if (!m_ToolbarShown) {
+                return false;
+            }
+            QPoint p = toPixels(event->button.x, event->button.y);
+            int button = m_OverlayManager.toolbarButtonAt(p.x() - barX, p.y());
+            if (button < 0) {
+                return false;
+            }
+            m_ToolbarSwallowUp = true;
+            solinearToolbarAction(button);
+            return true;
+        }
+    case SDL_MOUSEBUTTONUP:
+        if (m_ToolbarSwallowUp) {
+            m_ToolbarSwallowUp = false;
+            return true;
+        }
+        return false;
+    default:
+        return false;
+    }
+}
