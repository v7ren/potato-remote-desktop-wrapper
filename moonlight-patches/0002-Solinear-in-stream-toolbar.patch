+void OverlayManager::setToolbar(const QStringList& labels, const QVector<bool>& lit)
+{
+    m_ToolbarLabels = labels;
+    m_ToolbarLit = lit;
+    bool wasShown = m_Overlays[OverlayToolbar].enabled;
+    setOverlayState(OverlayToolbar, !labels.isEmpty());
+    if (wasShown && !labels.isEmpty()) {
+        notifyOverlayUpdated(OverlayToolbar);  // setOverlayState() only redraws on a show/hide change
+    }
+    if (labels.isEmpty()) {
+        m_ToolbarRanges.clear();
+        m_ToolbarSize = QSize();
+    }
+}
+
+int OverlayManager::toolbarButtonAt(int x, int y) const
+{
+    if (y < 0 || y >= m_ToolbarSize.height()) {
+        return -1;
+    }
+    for (int i = 0; i < m_ToolbarRanges.size(); i++) {
+        if (x >= m_ToolbarRanges[i].first && x < m_ToolbarRanges[i].second) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+QSize OverlayManager::toolbarSize() const
+{
+    return m_ToolbarSize;
+}
+
+SDL_Surface* OverlayManager::renderToolbar(TTF_Font* font)
+{
+    const int padX = 16, padY = 8, gap = 6;
+    TTF_SetFontOutline(font, 0);
+    QVector<int> widths;
+    int total = gap;
+    for (const QString& label : m_ToolbarLabels) {
+        int w = 0, h = 0;
+        TTF_SizeUTF8(font, label.toUtf8().constData(), &w, &h);
+        widths.append(w + 2 * padX);
+        total += w + 2 * padX + gap;
+    }
+    const int buttonH = TTF_FontHeight(font) + 2 * padY;
+    SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(0, total, buttonH + 2 * gap, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (surface == nullptr) {
+        return nullptr;
+    }
+    SDL_FillRect(surface, nullptr, SDL_MapRGBA(surface->format, 12, 12, 12, 235));
+
+    m_ToolbarRanges.clear();
+    int x = gap;
+    for (int i = 0; i < m_ToolbarLabels.size(); i++) {
+        bool lit = m_ToolbarLit.value(i);
+        SDL_Rect button = {x, gap, widths[i], buttonH};
+        SDL_FillRect(surface, &button, lit ? SDL_MapRGBA(surface->format, 242, 242, 242, 255)
+                                           : SDL_MapRGBA(surface->format, 32, 32, 32, 255));
+        SDL_Color color = lit ? SDL_Color{5, 5, 5, 255} : SDL_Color{220, 220, 220, 255};
+        SDL_Surface* text = TTF_RenderUTF8_Blended(font, m_ToolbarLabels[i].toUtf8().constData(), color);
+        if (text != nullptr) {
+            SDL_Rect at = {x + padX, gap + padY, text->w, text->h};
+            SDL_SetSurfaceBlendMode(text, SDL_BLENDMODE_BLEND);
+            SDL_BlitSurface(text, nullptr, surface, &at);
+            SDL_FreeSurface(text);
+        }
+        m_ToolbarRanges.append({x, x + widths[i]});
+        x += widths[i] + gap;
+    }
+    m_ToolbarSize = QSize(surface->w, surface->h);
+    return surface;
+}
