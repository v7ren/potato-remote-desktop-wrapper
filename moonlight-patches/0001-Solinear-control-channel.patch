diff --git a/app/streaming/input/keyboard.cpp b/app/streaming/input/keyboard.cpp
index 29e218d..33a3f1f 100644
--- a/app/streaming/input/keyboard.cpp
+++ b/app/streaming/input/keyboard.cpp
@@ -22,6 +22,40 @@
 #define GET_KEYPRESS_EXTENDED_MODIFIER(x) ((char)(((x) >> 16) & 0xFF))
 #define GET_KEYPRESS_FLAGS(x) ((char)(((x) >> 24) & 0xFF))
 
+bool SdlInputHandler::performNamedCombo(const QString& name)
+{
+    static const QHash<QString, KeyCombo> combos = {
+        {"quit", KeyComboQuit}, {"ungrab", KeyComboUngrabInput}, {"fullscreen", KeyComboToggleFullScreen},
+        {"stats", KeyComboToggleStatsOverlay}, {"mouse-mode", KeyComboToggleMouseMode},
+        {"minimize", KeyComboToggleMinimize}, {"paste", KeyComboPasteText},
+    };
+    auto it = combos.find(name);
+    if (it == combos.end()) {
+        return false;
+    }
+    performSpecialKeyCombo(it.value());
+    return true;
+}
+
+void SdlInputHandler::sendHostShortcut(short vk)
+{
+    // The host watches the modifier keys themselves (not just the modifier flags) to detect its shortcuts
+    static const struct { short vk; char flag; } mods[] = {
+        {0xA2, MODIFIER_CTRL}, {0xA4, MODIFIER_ALT}, {0xA0, MODIFIER_SHIFT},
+    };
+    char held = 0;
+    for (const auto& m : mods) {
+        held |= m.flag;
+        LiSendKeyboardEvent(0x8000 | m.vk, KEY_ACTION_DOWN, held);
+    }
+    LiSendKeyboardEvent(0x8000 | vk, KEY_ACTION_DOWN, held);
+    LiSendKeyboardEvent(0x8000 | vk, KEY_ACTION_UP, held);
+    for (int i = 2; i >= 0; i--) {
+        held &= ~mods[i].flag;
+        LiSendKeyboardEvent(0x8000 | mods[i].vk, KEY_ACTION_UP, held);
+    }
+}
+
