 {
     switch (combo) {
diff --git a/app/streaming/session.cpp b/app/streaming/session.cpp
index 40c1e59..34e439b 100644
--- a/app/streaming/session.cpp
+++ b/app/streaming/session.cpp
@@ -1,4 +1,8 @@
 #include "session.h"
+#include <iostream>
+#include <mutex>
+#include <string>
+#include <thread>
 #include "settings/streamingpreferences.h"
 #include "streaming/streamutils.h"
 #include "backend/richpresencemanager.h"
@@ -28,6 +32,41 @@
 #define SDL_CODE_GAMECONTROLLER_SET_MOTION_EVENT_STATE 103
 #define SDL_CODE_GAMECONTROLLER_SET_CONTROLLER_LED 104
 #define SDL_CODE_GAMECONTROLLER_SET_ADAPTIVE_TRIGGERS 105
+#define SDL_CODE_SOLINEAR_COMMAND 200
+
+// Solinear: a launcher runs Moonlight with SOLINEAR_CONTROL=1 and talks to the stream through stdin/stdout,
+// one line each way: status out ("stage <name>", "connected", "error <text>", "ended"), commands in
+// ("combo <name>", "screen <1-12>", "quit"). No simulated key presses, no window focus games.
+static bool solinearControl()
+{
+    static const bool on = qEnvironmentVariableIntValue("SOLINEAR_CONTROL") == 1;
+    return on;
+}
+
+static void solinearStatus(const QString& line)
+{
+    if (solinearControl()) {
+        fputs((line.simplified() + "\n").toUtf8().constData(), stdout);
+        fflush(stdout);
+    }
+}
+
+static void solinearStartReader()
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        std::thread([] {
+            std::string line;
+            while (std::getline(std::cin, line)) {
+                SDL_Event event = {};
+                event.type = SDL_USEREVENT;
+                event.user.code = SDL_CODE_SOLINEAR_COMMAND;
+                event.user.data1 = new std::string(line);
+                SDL_PushEvent(&event);
+            }
+        }).detach();  // ends with the process; stdin closes when the launcher goes away
+    });
+}
 
 #include <openssl/rand.h>
 
@@ -72,6 +111,7 @@ void Session::clStageStarting(int stage)
     // which happens to be the main thread, so it's cool to interact
     // with the GUI in these callbacks.
     emit s_ActiveSession->stageStarting(QString::fromLocal8Bit(LiGetStageName(stage)));
+    solinearStatus(QString("stage ") + LiGetStageName(stage));
 }
 
 void Session::clStageFailed(int stage, int errorCode)
@@ -586,6 +626,33 @@ Session::Session(NvComputer* computer, NvApp& app, StreamingPreferences *prefere
       m_AudioSampleCount(0),
       m_DropAudioEndTime(0)
 {
+    if (solinearControl()) {
+        connect(this, &Session::displayLaunchError, this, [](QString text) { solinearStatus("error " + text); });
+        connect(this, &Session::stageFailed, this, [](QString stage, int code, QString) {
+            solinearStatus(QString("error %1 failed (%2)").arg(stage).arg(code));
+        });
+    }
+}
+
+void Session::handleSolinearCommand(const QString& line)
+{
+    const QStringList words = line.simplified().split(' ', Qt::SkipEmptyParts);
+    const QString cmd = words.value(0), arg = words.value(1);
+    bool ok = false;
+    if (cmd == "combo") {
+        ok = m_InputHandler->performNamedCombo(arg);
+    }
+    else if (cmd == "screen") {
+        int n = arg.toInt(&ok);
+        ok = ok && n >= 1 && n <= 12;
+        if (ok) {
+            m_InputHandler->sendHostShortcut(0x70 + n - 1);  // VK_F1 + n - 1
+        }
+    }
+    else if (cmd == "quit") {
+        ok = m_InputHandler->performNamedCombo("quit");
+    }
+    solinearStatus((ok ? "ok " : "unknown ") + line);
 }
 
 Session::~Session()
@@ -1960,6 +2027,11 @@ void Session::exec()
     // Switch to async logging mode when we enter the SDL loop
     StreamUtils::enterAsyncLoggingMode();
 
+    if (solinearControl()) {
+        solinearStartReader();
+        solinearStatus("connected");
+    }
+
     // Hijack this thread to be the SDL main thread. We have to do this
     // because we want to suspend all Qt processing until the stream is over.
     SDL_Event event;
@@ -2036,6 +2108,12 @@ void Session::exec()
                 m_InputHandler->setAdaptiveTriggers((uint16_t)(uintptr_t)event.user.data1,
                                                     (DualSenseOutputReport *)event.user.data2);
                 break;
+            case SDL_CODE_SOLINEAR_COMMAND:
+                {
+                    std::unique_ptr<std::string> line((std::string*)event.user.data1);
+                    handleSolinearCommand(QString::fromStdString(*line));
+                }
+                break;
             default:
                 SDL_assert(false);
             }
@@ -2372,6 +2450,8 @@ DispatchDeferredCleanup:
 
     SDL_QuitSubSystem(SDL_INIT_VIDEO);
 
+    solinearStatus("ended");
+
     // Cleanup can take a while, so dispatch it to a worker thread.
     // When it is complete, it will release our s_ActiveSessionSemaphore
     // reference.
