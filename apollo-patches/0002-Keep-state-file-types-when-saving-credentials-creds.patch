From 486921fccd7383d5c9536880cc4dfdb70b16c3fa Mon Sep 17 00:00:00 2001
From: "v7r.envy" <noreply@example.invalid>
Date: Sun, 29 Nov 2026 00:14:00 +0800
Subject: [PATCH 2/6] Keep state file types when saving credentials (--creds)

save_user_creds round-tripped the whole file through a boost ptree, turning the server state's
numbers and booleans into strings; Apollo then failed reading its state. Use nlohmann::json.
---
 src/httpcommon.cpp | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/src/httpcommon.cpp b/src/httpcommon.cpp
index 8fa8092..f1ae76c 100644
--- a/src/httpcommon.cpp
+++ b/src/httpcommon.cpp
@@ -6,6 +6,7 @@
 
 // standard includes
 #include <filesystem>
+#include <fstream>
 #include <utility>
 
 // lib includes
@@ -15,6 +16,7 @@
 #include <boost/property_tree/ptree.hpp>
 #include <boost/property_tree/xml_parser.hpp>
 #include <curl/curl.h>
+#include <nlohmann/json.hpp>
 #include <Simple-Web-Server/server_http.hpp>
 #include <Simple-Web-Server/server_https.hpp>
 
@@ -68,11 +70,18 @@ namespace http {
   }
 
   int save_user_creds(const std::string &file, const std::string &username, const std::string &password, bool run_our_mouth) {
-    pt::ptree outputTree;
+    // Solinear: nlohmann, not a ptree. The credentials can share a file with the server state, and a ptree
+    // round trip turns that state's numbers and booleans into strings, which later crashes reading it.
+    nlohmann::json outputTree = nlohmann::json::object();
 
     if (fs::exists(file)) {
       try {
-        pt::read_json(file, outputTree);
+        std::ifstream in(file);
+        outputTree = nlohmann::json::parse(in);
+        if (!outputTree.is_object()) {
+          BOOST_LOG(error) << "Couldn't read user credentials: not a JSON object"sv;
+          return -1;
+        }
       } catch (std::exception &e) {
         BOOST_LOG(error) << "Couldn't read user credentials: "sv << e.what();
         return -1;
@@ -80,11 +89,13 @@ namespace http {
     }
 
     auto salt = crypto::rand_alphabet(16);
-    outputTree.put("username", username);
-    outputTree.put("salt", salt);
-    outputTree.put("password", util::hex(crypto::hash(password + salt)).to_string());
+    outputTree["username"] = username;
+    outputTree["salt"] = salt;
+    outputTree["password"] = util::hex(crypto::hash(password + salt)).to_string();
     try {
-      pt::write_json(file, outputTree);
+      std::ofstream out(file);
+      out.exceptions(std::ofstream::failbit | std::ofstream::badbit);
+      out << outputTree.dump(4);
     } catch (std::exception &e) {
       BOOST_LOG(error) << "error writing to the credentials file, perhaps try this again as an administrator? Details: "sv << e.what();
       return -1;
-- 
