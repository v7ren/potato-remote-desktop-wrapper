From 134fdf26d731756746d496df21242a098bfa383f Mon Sep 17 00:00:00 2001
From: "v7r.envy" <noreply@example.invalid>
Date: Sun, 29 Nov 2026 00:28:01 +0800
Subject: [PATCH 5/7] Build with current MSYS2: OpenSSL 3.6 accessors, MinGW's
 own synthetic pointer API

---
 src/crypto.cpp                 | 6 ++++--
 src/platform/windows/input.cpp | 7 +------
 2 files changed, 5 insertions(+), 8 deletions(-)

diff --git a/src/crypto.cpp b/src/crypto.cpp
index 0f7fbe2..4cd77e4 100644
--- a/src/crypto.cpp
+++ b/src/crypto.cpp
@@ -387,7 +387,8 @@ namespace crypto {
     const ASN1_BIT_STRING *asn1 = nullptr;
     X509_get0_signature(&asn1, nullptr, x.get());
 
-    return {(const char *) asn1->data, (std::size_t) asn1->length};
+    // accessors, not fields: OpenSSL 3.6 made ASN1_BIT_STRING opaque
+    return {(const char *) ASN1_STRING_get0_data(asn1), (std::size_t) ASN1_STRING_length(asn1)};
   }
 
   std::string rand(std::size_t bytes) {
@@ -457,7 +458,8 @@ namespace crypto {
 
     X509_set_pubkey(x509.get(), pkey.get());
 
-    auto name = X509_get_subject_name(x509.get());
+    // OpenSSL 3.6 returns it const; it is this new certificate's own name, which we fill in here
+    auto name = const_cast<X509_NAME *>(X509_get_subject_name(x509.get()));
     X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC, (const std::uint8_t *) cn.data(), cn.size(), -1, 0);
 
     X509_set_issuer_name(x509.get(), name);
diff --git a/src/platform/windows/input.cpp b/src/platform/windows/input.cpp
index 9d182c7..a538408 100644
--- a/src/platform/windows/input.cpp
+++ b/src/platform/windows/input.cpp
@@ -22,12 +22,7 @@
 #include "src/logging.h"
 #include "src/platform/common.h"
 
-#ifdef __MINGW32__
-DECLARE_HANDLE(HSYNTHETICPOINTERDEVICE);
-WINUSERAPI HSYNTHETICPOINTERDEVICE WINAPI CreateSyntheticPointerDevice(POINTER_INPUT_TYPE pointerType, ULONG maxCount, POINTER_FEEDBACK_MODE mode);
-WINUSERAPI BOOL WINAPI InjectSyntheticPointerInput(HSYNTHETICPOINTERDEVICE device, CONST POINTER_TYPE_INFO *pointerInfo, UINT32 count);
-WINUSERAPI VOID WINAPI DestroySyntheticPointerDevice(HSYNTHETICPOINTERDEVICE device);
-#endif
+// (current MinGW headers declare the synthetic pointer API themselves; the old local copy clashed)
 
 namespace platf {
   using namespace std::literals;
-- 
2.51.1.windows.1

