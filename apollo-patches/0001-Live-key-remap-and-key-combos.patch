 src/config.h       |  2 ++
 src/confighttp.cpp | 52 ++++++++++++++++++++++++++++++++++++++++++++++
 src/input.cpp      | 50 ++++++++++++++++++++++++++++++++++++++++++++
 src/input.h        |  7 +++++++
 5 files changed, 116 insertions(+)

