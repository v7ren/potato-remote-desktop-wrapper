diff --git a/src/input.cpp b/src/input.cpp
index 6c03d0d..e61df40 100644
--- a/src/input.cpp
+++ b/src/input.cpp
@@ -13,6 +13,8 @@ extern "C" {
 #include <chrono>
 #include <cmath>
 #include <list>
+#include <mutex>
+#include <set>
 #include <thread>
 #include <unordered_map>
 
@@ -616,7 +618,17 @@ namespace input {
     platf::button_mouse(platf_input, button, release);
   }
 
+  // Solinear: the remap can change while streaming (set_remap), so it is read under this lock.
+  static std::mutex remap_mutex;
+
+  void set_remap(std::unordered_map<int, int> keybindings, std::vector<int> keycombos) {
+    std::lock_guard lock {remap_mutex};
+    config::input.keybindings = std::move(keybindings);
+    config::input.keycombos = std::move(keycombos);
+  }
+
   short map_keycode(short keycode) {
+    std::lock_guard lock {remap_mutex};
     auto it = config::input.keybindings.find(keycode);
     if (it != std::end(config::input.keybindings)) {
       return it->second;
@@ -625,6 +637,29 @@ namespace input {
     return keycode;
   }
 
+  // Solinear: key combos. A held key M normally goes out as map_keycode(M); a rule [M, K, N] makes M go out as N
+  // from the moment K is pressed while M is held, until M is released. E.g. a Mac's Cmd arrives as Win and is
+  // remapped to Ctrl (Cmd+C = Ctrl+C), but Cmd+Tab must be Alt+Tab: [Win, Tab, Alt].
+  static std::set<uint16_t> held_keys;  // keys held on the client, before any remap
+  static std::unordered_map<uint16_t, uint16_t> combo_override;  // held key -> key it goes out as now
+
+  void apply_combos(uint16_t key_code, uint8_t flags) {
+    std::vector<int> combos;
+    {
+      std::lock_guard lock {remap_mutex};
+      combos = config::input.keycombos;
+    }
+    for (std::size_t i = 0; i + 2 < combos.size(); i += 3) {
+      auto held = (uint16_t) combos[i];
+      if (combos[i + 1] != key_code || !held_keys.count(held) || combo_override.count(held)) {
+        continue;
+      }
+      platf::keyboard_update(platf_input, map_keycode(held), true, flags);  // let go of what it was sent as
+      platf::keyboard_update(platf_input, (uint16_t) combos[i + 2], false, flags);
+      combo_override[held] = (uint16_t) combos[i + 2];
+    }
+  }
+
   /**
    * @brief Update flags for keyboard shortcut combo's
    */
@@ -769,6 +804,21 @@ namespace input {
 
     pressed = !release;
 
+    if (release) {
+      held_keys.erase(keyCode);
+      auto it = combo_override.find(keyCode);
+      if (it != combo_override.end()) {
+        // this key was standing in for a combo's replacement: release that instead
+        platf::keyboard_update(platf_input, it->second, true, packet->flags);
+        combo_override.erase(it);
+        update_shortcutFlags(&input->shortcutFlags, map_keycode(keyCode), release);
+        return;
+      }
+    } else {
+      apply_combos(keyCode, packet->flags);
+      held_keys.insert(keyCode);
+    }
+
     send_key_and_modifiers(keyCode, release, packet->flags, synthetic_modifiers);
 
     update_shortcutFlags(&input->shortcutFlags, map_keycode(keyCode), release);
