diff --git a/src/confighttp.cpp b/src/confighttp.cpp
index e270dd7..d714f50 100644
--- a/src/confighttp.cpp
+++ b/src/confighttp.cpp
@@ -31,6 +31,7 @@
 #include "file_handler.h"
 #include "globals.h"
 #include "httpcommon.h"
+#include "input.h"
 #include "logging.h"
 #include "network.h"
 #include "nvhttp.h"
@@ -1304,6 +1305,56 @@ namespace confighttp {
    *
    * @api_examples{/api/reset-display-device-persistence| POST| null}
    */
+  /**
+   * @brief Solinear: replace the key remap without restarting, so a running stream is not dropped.
+   * @param response The HTTP response object.
+   * @param request The HTTP request object.
+   *
+   * @api_examples{/api/input-remap| POST| {"keybindings":[91,162],"keycombos":[91,9,164]}}
+   */
+  void saveInputRemap(resp_https_t response, req_https_t request) {
+    if (!validateContentType(response, request, "application/json") || !authenticate(response, request)) {
+      return;
+    }
+
+    print_req(request);
+
+    try {
+      std::stringstream ss;
+      ss << request->content.rdbuf();
+      nlohmann::json input_tree = nlohmann::json::parse(ss.str());
+      auto bindings = input_tree.value("keybindings", std::vector<int> {});
+      auto combos = input_tree.value("keycombos", std::vector<int> {});
+      if (bindings.size() % 2 || combos.size() % 3) {
+        bad_request(response, request, "keybindings needs pairs, keycombos needs triples");
+        return;
+      }
+      for (auto v : bindings) {
+        if (v < 0 || v > 0xFF) {
+          bad_request(response, request, "key codes must be 0-255");
+          return;
+        }
+      }
+      for (auto v : combos) {
+        if (v < 0 || v > 0xFF) {
+          bad_request(response, request, "key codes must be 0-255");
+          return;
+        }
+      }
+      std::unordered_map<int, int> map;
+      for (std::size_t i = 0; i < bindings.size(); i += 2) {
+        map[bindings[i]] = bindings[i + 1];
+      }
+      input::set_remap(std::move(map), std::move(combos));
+      nlohmann::json output_tree;
+      output_tree["status"] = true;
+      send_response(response, output_tree);
+    } catch (std::exception &e) {
+      BOOST_LOG(warning) << "SaveInputRemap: "sv << e.what();
+      bad_request(response, request, e.what());
+    }
+  }
+
   void resetDisplayDevicePersistence(resp_https_t response, req_https_t request) {
     if (!validateContentType(response, request, "application/json") || !authenticate(response, request)) {
       return;
@@ -1545,6 +1596,7 @@ namespace confighttp {
     server.resource["^/api/restart$"]["POST"] = restart;
     server.resource["^/api/quit$"]["POST"] = quit;
     server.resource["^/api/reset-display-device-persistence$"]["POST"] = resetDisplayDevicePersistence;
+    server.resource["^/api/input-remap$"]["POST"] = saveInputRemap;
     server.resource["^/api/password$"]["POST"] = savePassword;
     server.resource["^/api/clients/unpair-all$"]["POST"] = unpairAll;
