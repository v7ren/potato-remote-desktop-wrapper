     int_between_f(vars, "fec_percentage", stream.fec_percentage, {1, 255});
 
     map_int_int_f(vars, "keybindings"s, input.keybindings);
+    list_int_f(vars, "keycombos"s, input.keycombos);
+    if (input.keycombos.size() % 3) {
+      BOOST_LOG(warning) << "config: expected keycombos to have a multiple of three elements --> not "sv << input.keycombos.size();
+      input.keycombos.clear();
